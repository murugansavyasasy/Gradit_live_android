<?xml version="1.0" encoding="utf-8"?>
<!-- Notice Board card — soft amber pastel -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF3E1" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#F6E2BE" />
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
