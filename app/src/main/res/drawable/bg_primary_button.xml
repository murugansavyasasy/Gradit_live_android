<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action button: #0070EB (Figma exact), border-radius 8dp for auth screens -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#0058BC" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#0070EB" />
        </shape>
    </item>
</selector>
