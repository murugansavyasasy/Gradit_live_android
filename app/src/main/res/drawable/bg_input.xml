<?xml version="1.0" encoding="utf-8"?>
<!-- Input field: translucent white, 2dp border #C1C6D7, 8dp corner (from Figma) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#80FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#0058BC" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#80FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#C1C6D7" />
        </shape>
    </item>
</selector>
