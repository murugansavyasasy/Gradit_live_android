<?xml version="1.0" encoding="utf-8"?>
<!-- Events: "My Requests" button (lavender pill) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9DEF3" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#C7CEEC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8EBF7" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#DCE1F3" />
        </shape>
    </item>
</selector>
