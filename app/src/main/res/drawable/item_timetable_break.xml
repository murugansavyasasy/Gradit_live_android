<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_timetable_break">

    <TextView
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:text="☕"
        android:textSize="24sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunch break"
            android:textColor="#855000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBreakTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:00 AM – 12:00 PM"
            android:textColor="#855000"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvBreakDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1h"
        android:textColor="#855000"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/bg_break_duration" />

</LinearLayout>