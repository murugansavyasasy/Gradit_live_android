<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/three"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Section header: accent bar + title on the left, "View all" pill on the right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginTop="@dimen/two"
            android:layout_marginEnd="@dimen/fifteen"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/idTVCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:drawableStart="@drawable/bg_section_accent"
                android:drawablePadding="@dimen/eight"
                android:gravity="center_vertical"
                android:text=""
                android:textColor="@color/clr_header_black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_view_all_pill"
                android:gravity="center"
                android:paddingStart="@dimen/twelve"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/twelve"
                android:paddingBottom="6dp"
                android:text="@string/txt_view_all"
                android:textColor="@color/clr_parent"
                android:textSize="@dimen/twelve"
                android:textStyle="bold"
                android:visibility="visible" />
        </RelativeLayout>

        <TextView
            android:id="@+id/lblNoRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginTop="@dimen/eight"
            android:layout_marginBottom="@dimen/five"
            android:text="No records found"
            android:textColor="@color/light_gray"
            android:textSize="@dimen/twelve"
            android:textStyle="normal" />

        <androidx.cardview.widget.CardView
            android:id="@+id/idCVCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twelve"
            android:layout_marginTop="@dimen/two"
            android:layout_marginEnd="@dimen/twelve"
            android:visibility="visible"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/three">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerDashboardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerDashboardMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lblSwipeForMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginBottom="@dimen/five"
                    android:gravity="end"
                    android:text="Swipe for more menu  ›"
                    android:textColor="@color/clr_parent"
                    android:textSize="@dimen/eleve_sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>