<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ============ RECIPIENT SELECTION ROW ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutEntireCollege"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_card_white"
        android:elevation="1dp"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <CheckBox
            android:id="@+id/chbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/clr_principal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lblRecipientData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Entire College"
            android:textColor="@color/clr_header_black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/lblRegNo1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chbox"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/lblRegNo1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/light_gray"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chbox"
            app:layout_constraintTop_toBottomOf="@+id/lblRecipientData" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ ATTENDANCE ROW ============ -->
    <RelativeLayout
        android:id="@+id/con_attendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_card_white"
        android:elevation="1dp"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Present/Absent badge -->
        <TextView
            android:id="@+id/img_mark_attendance"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/round_green"
            android:gravity="center"
            android:text="P"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"
            android:textStyle="bold" />

        <!-- Student name -->
        <TextView
            android:id="@+id/lbl_studentname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/img_mark_attendance"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="StudentName"
            android:textColor="@color/clr_header_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblRegNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lbl_studentname"
            android:layout_alignParentStart="true"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/light_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lblAdmissionNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblRegNo"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/light_gray"
            android:textSize="13sp" />

        <!-- Divider -->
        <View
            android:id="@+id/viewRecipientDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/lblAdmissionNo"
            android:layout_marginTop="12dp"
            android:background="#EEEFF3" />

        <!-- On-Duty / On-Leave toggles -->
        <LinearLayout
            android:id="@+id/lnrToggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/viewRecipientDivider"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <RelativeLayout
                android:id="@+id/rlaSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/lblOD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="On-Duty"
                    android:textColor="@color/clr_header_black"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchOD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/lblOD"
                    android:layout_marginStart="8dp"
                    android:checked="false" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaSwitchOnLeave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/lblOnLeave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="On-Leave"
                    android:textColor="@color/clr_header_black"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchOnLeave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/lblOnLeave"
                    android:layout_marginStart="8dp"
                    android:checked="false" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
