<?xml version="1.0" encoding="utf-8"?>
<!-- Customize Your Resume: one collapsible section card (header + body). The body content is
     added in code (CustomizeResumeActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_cr_card"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/imgSectionIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cr_tint"
            android:padding="10dp"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lblSectionAiBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_cr_badge"
                android:drawableStart="@drawable/ic_cr_spark"
                android:drawablePadding="4dp"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/txt_cr_ai_enhanced"
                android:textColor="@color/dark_blue"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblSectionSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="#6B6B73"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Included / Hidden pill: whether the section goes into the resume -->
        <TextView
            android:id="@+id/btnSectionInclude"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:drawablePadding="4dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/imgSectionChevron"
            android:layout_width="32dp"
            android:layout_height="44dp"
            android:padding="7dp"
            android:src="@drawable/ic_cr_chevron_down"
            app:tint="#3A3A40"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Body: shown when the section is open -->
    <LinearLayout
        android:id="@+id/layoutSectionBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F3" />

        <LinearLayout
            android:id="@+id/layoutSectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp" />
    </LinearLayout>
</LinearLayout>
