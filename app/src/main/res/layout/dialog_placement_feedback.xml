<?xml version="1.0" encoding="utf-8"?>
<!-- Placement Feedback: "We're listening" bottom sheet (plain Dialog, see PlacementFeedback). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pf_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pf_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pf_icon_box"
            android:padding="13dp"
            android:src="@drawable/ic_pf_chat"
            app:tint="#C2410C"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:letterSpacing="0.08"
                android:text="@string/txt_pf_listening"
                android:textColor="#5E5E66"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/txt_pf_sheet_title"
                android:textColor="#14213D"
                android:textSize="22sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgFeedbackClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pf_close"
            android:contentDescription="@string/txt_delete_close"
            android:padding="13dp"
            android:src="@drawable/ic_cr_chevron_down"
            app:tint="#1C1C1E" />
    </LinearLayout>

    <!-- Form scrolls when the keyboard leaves little room, so Submit is always reachable -->
    <ScrollView
        android:id="@+id/scrollFeedbackForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/txt_pf_topic"
                android:textColor="#1C1C1E"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtFeedbackTopic"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pf_input"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/txt_pf_topic_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1C1C1E"
                android:textColorHint="#8E8E93"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/txt_pf_your_feedback"
                android:textColor="#1C1C1E"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtFeedbackMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pf_input"
                android:fontFamily="@font/poppins_regular"
                android:gravity="top|start"
                android:hint="@string/txt_pf_message_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4"
                android:maxLines="6"
                android:overScrollMode="ifContentScrolls"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                android:padding="14dp"
                android:textColor="#1C1C1E"
                android:textColorHint="#8E8E93"
                android:textSize="15sp" />

            <!-- Role colour set in code -->
            <TextView
                android:id="@+id/btnSubmitFeedback"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/txt_pf_submit"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
