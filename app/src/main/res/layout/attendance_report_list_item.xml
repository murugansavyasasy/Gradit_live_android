<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp">

    <RelativeLayout
        android:id="@+id/rytParentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:elevation="2dp"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Calendar date badge -->
            <LinearLayout
                android:id="@+id/lnrDate"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/lblMonth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_date_month_top"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Oct"
                    android:textColor="@color/clr_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/clr_day_blue"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:text="12"
                    android:textColor="@color/clr_black"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_date_body_bottom"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:text="Monday"
                    android:textColor="@color/clr_black"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Status pill -->
            <TextView
                android:id="@+id/lblStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_green"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="Present"
                android:textColor="@color/clr_white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/imgPunchHistory"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Staff name (staff-wise only) -->
            <TextView
                android:id="@+id/lblStaffName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/clr_month_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@+id/lblStatus"
                app:layout_constraintStart_toEndOf="@+id/lnrDate"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Attendance type / name -->
            <TextView
                android:id="@+id/lblName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/clr_header_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/lblStatus"
                app:layout_constraintStart_toEndOf="@+id/lnrDate"
                app:layout_constraintTop_toBottomOf="@+id/lblStaffName" />

            <!-- Check-in time -->
            <TextView
                android:id="@+id/lblCheckInTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:text="First in - 9:30 am"
                android:textColor="@color/light_gray"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@+id/imgPunchHistory"
                app:layout_constraintStart_toEndOf="@+id/lnrDate"
                app:layout_constraintTop_toBottomOf="@+id/lblName" />

            <!-- Check-out time -->
            <TextView
                android:id="@+id/lblCheckoutTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:text=""
                android:textColor="@color/light_gray"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@+id/imgPunchHistory"
                app:layout_constraintStart_toEndOf="@+id/lnrDate"
                app:layout_constraintTop_toBottomOf="@+id/lblCheckInTime" />

            <!-- Working hours -->
            <TextView
                android:id="@+id/lblWorkingHours"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/clr_header_black"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/imgPunchHistory"
                app:layout_constraintStart_toEndOf="@+id/lnrDate"
                app:layout_constraintTop_toBottomOf="@+id/lblCheckoutTime" />

            <!-- Punch history arrow -->
            <ImageView
                android:id="@+id/imgPunchHistory"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/txt_semester"
                android:src="@drawable/right_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
