<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_timetable_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Time -->
    <LinearLayout

        android:layout_width="74dp"
        android:layout_marginEnd="10dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00 AM"
            android:textColor="#20232F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00 AM"
            android:textColor="#626779"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Blue divider -->
    <View
        android:layout_width="4dp"
        android:layout_height="66dp"
        android:background="#3F4BD1 " />

    <!-- Subject details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPeriodName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PERIOD 1"
                android:textColor="#4050E5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1h"
                android:textColor="#626779"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Subject 2"
            android:textColor="#20232F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvFaculty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VRCR"
            android:textColor="#626779"
            android:textSize="15sp"
            android:drawableStart="@drawable/ic_person_outline"
            android:drawablePadding="7dp"
            android:layout_marginTop="5dp" />

    </LinearLayout>

</LinearLayout>