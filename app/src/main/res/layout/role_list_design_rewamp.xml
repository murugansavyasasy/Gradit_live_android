<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rytOverAll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:padding="12dp"
    android:background="@drawable/bg_item_rounded"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/lblAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:includeFontPadding="false" />

    <RelativeLayout
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/lblAvatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/lnrRoleDetails"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:orientation="vertical"
            android:layout_toStartOf="@+id/right_arrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/lblMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="abc"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/lblCollegeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="XYZ College"
                android:textSize="13sp"
                android:textColor="#666666" />
        </LinearLayout>

        <ImageView

            android:id="@+id/right_arrow"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/rightarrow"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty">

        </ImageView>

    </RelativeLayout>

</RelativeLayout>