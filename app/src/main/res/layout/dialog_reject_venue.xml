<?xml version="1.0" encoding="utf-8"?>
<!-- Approve Venue: "Reject this request?" dialog with a required reason -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_event_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/layoutRejectIcon"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/imgRejectIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_req_cross" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txt_reject_this_request"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblRejectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblRejectWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lbl_reason_for_rejection_required"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblReasonCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/250"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/edtRejectReason"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_req_reason_input"
        android:gravity="top|start"
        android:hint="@string/hint_reject_reason"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="250"
        android:padding="12dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/lblReasonError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_req_cross"
        android:drawablePadding="6dp"
        android:drawableTint="#E11D48"
        android:gravity="center_vertical"
        android:text="@string/msg_reject_reason_required"
        android:textColor="#E11D48"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lblReasonHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/txt_reject_reason_helper"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRejectGoBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_event_btn_cancel"
            android:stateListAnimator="@null"
            android:text="@string/txt_go_back"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRejectConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_req_btn_reject_solid"
            android:stateListAnimator="@null"
            android:text="@string/txt_reject"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
