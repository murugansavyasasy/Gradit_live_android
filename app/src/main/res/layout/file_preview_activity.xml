<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <RelativeLayout
        android:id="@+id/ImageLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <RelativeLayout
            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/imgMoreOptions"
            android:paddingVertical="@dimen/twenty">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/fifteen"
                android:src="@drawable/arrow_back" />

            <TextView
                android:id="@+id/lblSubject"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@+id/imgBack"
                android:text=""
                android:textSize="@dimen/fifteen_sp"
                android:visibility="visible" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/imgMoreOptions"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginEnd="@dimen/ten"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/five"
            android:src="@drawable/ic_more_vert"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcyFile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/lnrPrevious"
            android:layout_below="@+id/rytHeader"
            android:layout_marginTop="@dimen/eight"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:scrollbars="horizontal"
            android:visibility="visible" />


        <LinearLayout
            android:id="@+id/lnrPrevious"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/sixteen"
            android:background="@drawable/bg_round_radious_white"
            android:gravity="center"
            android:paddingStart="@dimen/fifteen"
            android:paddingTop="@dimen/fifteen"
            android:paddingEnd="@dimen/twenty_five"
            android:paddingBottom="@dimen/fifteen"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgPre"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:src="@drawable/left_icon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnrNext"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/sixteen"
            android:background="@drawable/bg_round_radious_white"
            android:gravity="center"
            android:paddingStart="@dimen/twenty_five"
            android:paddingTop="@dimen/fifteen"
            android:paddingEnd="@dimen/twenty_five"
            android:paddingBottom="@dimen/fifteen"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgNext"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:src="@drawable/right_arrow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnrDownloadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/twenty_five"
            android:background="@color/light_gray"
            android:elevation="@dimen/ten"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/twelve"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/thirty_two"
                android:layout_height="@dimen/thirty_two"
                android:layout_marginEnd="@dimen/eight"
                android:indeterminate="true"
                android:visibility="visible" />

            <TextView
                android:id="@+id/lblDownloading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DownLoading"
                android:textColor="@color/white"
                android:textSize="@dimen/sixteen_sp"
                android:visibility="visible" />
        </LinearLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>