<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:CircleImageView="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten"
    android:fitsSystemWindows="true"
    android:padding="@dimen/three">

    <RelativeLayout
        android:id="@+id/LayoutStaff"
        android:layout_width="170dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_shadow_white"
        android:padding="@dimen/ten"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgStaffProfile"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/five"
            android:scaleType="centerCrop"
            android:src="@drawable/chat_user_icon" />

        <TextView
            android:id="@+id/lblSubjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgStaffProfile"
            android:layout_marginTop="@dimen/eight"
            android:gravity="center"
            android:text="Test"
            android:textColor="@color/clr_selectedtab"
            android:textSize="@dimen/twelve"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/lblStaffName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblSubjectName"
            android:layout_marginTop="@dimen/five"
            android:gravity="center"
            android:text="Teaching staff"
            android:textColor="@color/black"
            android:textSize="@dimen/twelve"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rytSem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblStaffName"
            android:layout_marginTop="@dimen/five"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblyear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Year"
                android:textColor="@color/black"
                android:textSize="@dimen/twelve"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/lblview"
                android:layout_width="7dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/two"
                android:src="@drawable/starimage" />

            <TextView
                android:id="@+id/lblSemester"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:text="Semester"
                android:textColor="@color/black"
                android:textSize="@dimen/twelve"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytSem"
            android:layout_marginTop="@dimen/two"
            android:gravity="center"
            android:text="Section"
            android:textColor="@color/black"
            android:textSize="@dimen/twelve"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblInteract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/ten"
            android:background="@drawable/bg_submit_outer_green"
            android:paddingHorizontal="@dimen/fifteen"
            android:paddingVertical="@dimen/five"
            android:text="Interact"
            android:textAlignment="center"
            android:textColor="@color/clr_green_submit"
            android:textSize="@dimen/ten" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
