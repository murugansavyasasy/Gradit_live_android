<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rytOverAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_white"
        android:elevation="2dp"
        android:padding="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Faculty photo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFaclutyPhoto"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/faculty_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="#E6F7F0"
            app:strokeWidth="2dp" />

        <!-- Name (heading) -->
        <TextView
            android:id="@+id/lblStaffName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/clr_header_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/lblStaffType"
            app:layout_constraintEnd_toStartOf="@+id/btn_intreact"
            app:layout_constraintStart_toEndOf="@+id/imgFaclutyPhoto"
            app:layout_constraintTop_toTopOf="@+id/imgFaclutyPhoto"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Staff type (subtitle) -->
        <TextView
            android:id="@+id/lblStaffType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/light_gray"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/imgFaclutyPhoto"
            app:layout_constraintEnd_toStartOf="@+id/btn_intreact"
            app:layout_constraintStart_toEndOf="@+id/imgFaclutyPhoto"
            app:layout_constraintTop_toBottomOf="@+id/lblStaffName" />

        <!-- Interact button -->
        <TextView
            android:id="@+id/btn_intreact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_enable_greenn"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp"
            android:text="Interact"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imgFaclutyPhoto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imgFaclutyPhoto" />

        <!-- Subject handled (visible for p4) -->
        <LinearLayout
            android:id="@+id/layoutSubjecthandled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgFaclutyPhoto">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#EEEFF3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSubjectName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_subject_handled"
                    android:textColor="@color/light_gray"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblcolon3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text=":"
                    android:textColor="@color/light_gray"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblSubjectName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/clr_header_black"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
