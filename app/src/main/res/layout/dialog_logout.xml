<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="28dp"
    android:layout_marginEnd="28dp"
    android:background="@drawable/bg_dialog_card"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- Icon badge -->
    <FrameLayout
        android:id="@+id/iconBadge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_logout_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/txt_logout_title"
            android:src="@drawable/ic_logout" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/lblLogoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/txt_logout_title"
        android:textColor="@color/clr_header_black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconBadge" />

    <!-- Message -->
    <TextView
        android:id="@+id/lblLogoutMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/txt_logout_message"
        android:textColor="@color/light_gray"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblLogoutTitle" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btnLogoutCancel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_btn_dialog_cancel"
        android:stateListAnimator="@null"
        android:text="@string/txt_cancel"
        android:textAllCaps="false"
        android:textColor="@color/clr_header_black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btnLogoutConfirm"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblLogoutMessage" />

    <Button
        android:id="@+id/btnLogoutConfirm"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_btn_logout_red"
        android:stateListAnimator="@null"
        android:text="@string/txt_logout_confirm"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnLogoutCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnLogoutCancel"
        app:layout_constraintTop_toTopOf="@+id/btnLogoutCancel" />

</androidx.constraintlayout.widget.ConstraintLayout>
