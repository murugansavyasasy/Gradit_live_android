<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    >

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_select_country_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:id="@+id/headerLayout"
        android:background="@drawable/bg_select_country_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusBarBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">
        <ImageView
            android:layout_marginVertical="@dimen/twenty"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_back_button"
            android:contentDescription="Go back"
            android:padding="9dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:src="@drawable/ic_arrow_back" />


        <androidx.core.widget.NestedScrollView
            android:layout_marginTop="@dimen/ten"
            android:id="@+id/scrollPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_country_choose_panel"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:contentDescription="GRADIT Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/gradit_logo_2" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/select_country"
                    android:textColor="#0B1C30"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Choose  the country where your educational is located"
                    android:textColor="#414755"
                    android:textSize="15sp" />


                <RelativeLayout
                    android:id="@+id/rlaSearch"
                    android:paddingVertical="@dimen/ten"
                    android:paddingHorizontal="@dimen/five"
                    android:background="@drawable/bg_white_radius_5"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_marginStart="@dimen/five"
                        android:layout_centerVertical="true"
                        android:id="@+id/imgSearch"
                        android:layout_alignParentStart="true"
                        android:layout_width="@dimen/twenty_five"
                        android:src="@drawable/ic_search"
                        android:layout_height="@dimen/twenty_five">

                    </ImageView>

                    <EditText
                        android:layout_toEndOf="@+id/imgSearch"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:id="@+id/edtSearch"
                        android:layout_marginHorizontal="@dimen/five"
                        android:hint="Search Countries...."
                        android:textColor="#0B1C30"
                        android:textSize="@dimen/thirteen_sp"
                        android:textColorHint="#717786"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </EditText>

                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:id="@+id/rcCountryList"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_height="wrap_content">



                </androidx.recyclerview.widget.RecyclerView>
                <LinearLayout
                    android:id="@+id/lytList"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/nomessage"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:src="@drawable/no_country_message"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp" />

                    <TextView
                        android:id="@+id/txtNoData"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp" />


                </LinearLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/five"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <CheckBox
                        android:id="@+id/terms_checkbox"
                        style="@style/CustomCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        />

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_marginStart="@dimen/five"
                        android:id="@+id/lblTermsAndConditions"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/terms_checkbox"
                        android:textSize="@dimen/thirteen_sp" />
                </RelativeLayout>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/txt_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="@string/next_"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
