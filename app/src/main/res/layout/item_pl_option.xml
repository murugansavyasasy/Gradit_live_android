<?xml version="1.0" encoding="utf-8"?>
<!-- Placement hub: one option card (icon in a tinted circle, title, description, arrow).
     Icon, colours and texts are set in PlacementHome. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="150dp"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgPlOptionIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/lblPlOptionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#000000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lblPlOptionDesc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#5E5E66"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/imgPlOptionArrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_pl_arrow"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
