<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    tools:context=".Activities.Otp">

    <View
        android:id="@+id/view_header"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_gradient_header"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_white"
        android:padding="10dp"
        android:src="@drawable/arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/card_otp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_top_rounded"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        app:layout_constraintTop_toTopOf="@id/view_header"
        android:layout_marginTop="90dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/gradit_logo"
            android:contentDescription="Logo" />

        <TextView
            android:id="@+id/txt_otp_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Enter OTP"
            android:textColor="#101828"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_numberlable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Enter the verification code sent to +1(***) ***-5892"
            android:textColor="#475467"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/linear_edt_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txt_otp_1"
                style="@style/OtpBoxStyle" />

            <EditText
                android:id="@+id/txt_otp_2"
                style="@style/OtpBoxStyle" />

            <EditText
                android:id="@+id/txt_otp_3"
                style="@style/OtpBoxStyle" />

            <EditText
                android:id="@+id/txt_otp_4"
                style="@style/OtpBoxStyle" />

            <EditText
                android:id="@+id/txt_otp_5"
                style="@style/OtpBoxStyle" />

            <EditText
                android:id="@+id/txt_otp_6"
                style="@style/OtpBoxStyle"
                android:layout_marginEnd="0dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/lblDontRecieve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't receive the verification code?"
                android:textColor="#475467"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/lblResendCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Resend OTP in 00:26"
            android:textColor="#1450F5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_change_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Change mobile number"
            android:textColor="#1450F5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_verify_continue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_button_blue"
            android:gravity="center"
            android:text="Verify &amp; Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>