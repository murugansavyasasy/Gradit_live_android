<?xml version="1.0" encoding="utf-8"?>
<!-- Request List card. Colours (accent bar, status chip, info box) are set in VenueRequestAdapter.
     androidx CardView (works with the app's AppCompat themes; MaterialCardView needs a MaterialComponents theme).
     CardView has no stroke attribute, so the border is drawn by bg_venue_request_card on the inner layout. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_venue_request_card"
        android:orientation="horizontal">

        <!-- Left accent bar (venue colour) -->
        <View
            android:id="@+id/viewAccent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#94A3B8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Title + "⋮" menu (menu shown only for waiting requests) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgMore"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/txt_more_options"
                    android:padding="6dp"
                    android:src="@drawable/ic_req_more"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Status chip -->
            <TextView
                android:id="@+id/lblStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Date + time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_req_calendar"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textColor="#1E293B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_req_clock"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textColor="#1E293B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Venue -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_req_pin" />

                <View
                    android:id="@+id/viewVenueColor"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="10dp"
                    android:background="#94A3B8" />

                <TextView
                    android:id="@+id/lblVenue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="#475569"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Description + Read more -->
            <TextView
                android:id="@+id/lblDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lblReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="2dp"
                android:text="@string/txt_read_more"
                android:textColor="#0E7490"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Event message box -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgInfo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_req_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblInfoMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblInfoDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#334155"
                        android:textSize="13sp" />

                    <!-- Reason (rejected / cancelled) -->
                    <LinearLayout
                        android:id="@+id/layoutRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/lblRemarksLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblRemarks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:padding="8dp"
                            android:textColor="#1E293B"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Approve Venue only: requester (initials avatar, name, department) -->
            <LinearLayout
                android:id="@+id/layoutRequester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#E2E8F0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblRequesterInitials"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_req_avatar"
                        android:gravity="center"
                        android:textColor="#0E7490"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblRequesterName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblRequesterDepartment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Approve Venue only: Reject / Approve (by canreject / canapprove) -->
            <LinearLayout
                android:id="@+id/layoutDecision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btnRejectRequest"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_req_btn_reject_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawableStart="@drawable/ic_req_x"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/txt_reject"
                        android:textColor="#BE123C"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <Space
                    android:id="@+id/spaceDecision"
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/btnApproveRequest"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_req_btn_approve"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawableStart="@drawable/ic_req_tick_white"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/txt_approve"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Footer (booking id is not shown) -->
            <TextView
                android:id="@+id/lblRequestedOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
