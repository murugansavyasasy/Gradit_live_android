<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    >

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_select_country_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="0dp"
       android:id="@+id/headerLayout"
       android:background="@drawable/bg_select_country_header"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toBottomOf="@+id/statusBarBackground"
       app:layout_constraintBottom_toBottomOf="parent"
       android:layout_height="0dp">
       <ImageView
           android:layout_marginVertical="@dimen/twenty"
           android:id="@+id/btnBack"
           android:layout_width="40dp"
           android:layout_height="40dp"
           android:layout_gravity="start|center_vertical"
           android:background="@drawable/bg_back_button"
           android:contentDescription="Go back"
           android:padding="9dp"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintHorizontal_bias="0"
           android:layout_marginHorizontal="@dimen/fifteen"
           android:src="@drawable/ic_arrow_back" />


       <androidx.core.widget.NestedScrollView
           android:layout_marginTop="@dimen/ten"
           android:id="@+id/scrollPanel"
           android:layout_width="0dp"
           android:layout_height="0dp"
           android:background="@drawable/bg_country_choose_panel"
           android:fillViewport="true"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@id/btnBack">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:paddingStart="16dp"
               android:paddingEnd="16dp">

               <ImageView
                   android:id="@+id/imgLogo"
                   android:layout_width="64dp"
                   android:layout_height="64dp"
                   android:layout_gravity="center_horizontal"
                   android:layout_marginTop="16dp"
                   android:contentDescription="GRADIT Logo"
                   android:scaleType="fitCenter"
                   android:src="@drawable/gradit_logo_2" />

               <TextView
                   android:id="@+id/tvTitle"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="14dp"
                   android:gravity="center"
                   android:text="Change Password"
                   android:textColor="#0B1C30"
                   android:textSize="24sp"
                   android:textStyle="bold" />

               <TextView
                   android:id="@+id/tvSubtitle"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="6dp"
                   android:gravity="center"
                   android:text="Create a new secure password for your account"
                   android:textColor="#414755"
                   android:textSize="15sp" />


               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="28dp"
                   android:letterSpacing="0.05"
                   android:text="OLD PASSWORD"
                   android:textColor="#414755"
                   android:textSize="12sp"
                   android:textStyle="bold" />

               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8dp"
                   android:background="@drawable/bg_input">

                   <ImageView
                       android:id="@+id/imgoldLockPas"
                       android:layout_width="20dp"
                       android:layout_height="20dp"
                       android:layout_centerVertical="true"
                       android:layout_marginStart="14dp"
                       android:contentDescription="Password"
                       android:layout_alignParentStart="true"
                       android:src="@drawable/lock_icon_3" />

                   <EditText
                       android:layout_toEndOf="@+id/imgoldLockPas"
                       android:id="@+id/old_password_edt"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:background="@null"
                       android:paddingVertical="@dimen/fifteen"
                       android:hint="Enter old password"
                       android:layout_marginHorizontal="@dimen/five"
                       android:inputType="textPassword"
                       android:paddingStart="12dp"
                       android:layout_toStartOf="@+id/img_old_passwordopen"
                       android:textColor="#0B1C30"
                       android:textColorHint="#717786"
                       android:textSize="15sp" />

                   <ImageView
                       android:layout_alignParentEnd="true"
                       android:id="@+id/img_old_passwordopen"
                       android:layout_width="24dp"
                       android:layout_height="24dp"
                       android:layout_centerVertical="true"
                       android:layout_marginEnd="14dp"
                       android:contentDescription="Show/hide password"
                       android:padding="2dp"
                       android:src="@drawable/ic_eye_off_2" />

               </RelativeLayout>

               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="20dp"
                   android:letterSpacing="0.05"
                   android:text="NEW PASSWORD"
                   android:textColor="#414755"
                   android:textSize="12sp"
                   android:textStyle="bold" />

               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8dp"
                   android:background="@drawable/bg_input">

                   <ImageView
                       android:id="@+id/imgnewLockPas"
                       android:layout_width="20dp"
                       android:layout_height="20dp"
                       android:layout_centerVertical="true"
                       android:layout_marginStart="14dp"
                       android:contentDescription="Password"
                       android:layout_alignParentStart="true"
                       android:src="@drawable/lock_icon_3" />

                   <EditText
                       android:layout_toEndOf="@+id/imgnewLockPas"
                       android:id="@+id/new_password_edt"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:background="@null"
                       android:paddingVertical="@dimen/fifteen"
                       android:hint="Enter new password"
                       android:layout_marginHorizontal="@dimen/five"
                       android:inputType="textPassword"
                       android:paddingStart="12dp"
                       android:layout_toStartOf="@+id/img_new_passwordopen"
                       android:textColor="#0B1C30"
                       android:textColorHint="#717786"
                       android:textSize="15sp" />

                   <ImageView
                       android:layout_alignParentEnd="true"
                       android:id="@+id/img_new_passwordopen"
                       android:layout_width="24dp"
                       android:layout_height="24dp"
                       android:layout_centerVertical="true"
                       android:layout_marginEnd="14dp"
                       android:contentDescription="Show/hide password"
                       android:padding="2dp"
                       android:src="@drawable/ic_eye_off_2" />

               </RelativeLayout>


               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="@dimen/fifteen"
                   android:letterSpacing="0.05"
                   android:text="CONFIRM PASSWORD"
                   android:textColor="#414755"
                   android:textSize="12sp"
                   android:textStyle="bold" />

               <RelativeLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8dp"
                   android:background="@drawable/bg_input">

                   <ImageView
                       android:id="@+id/imgconfLockPas"
                       android:layout_width="20dp"
                       android:layout_height="20dp"
                       android:layout_centerVertical="true"
                       android:layout_marginStart="14dp"
                       android:contentDescription="Password"
                       android:layout_alignParentStart="true"
                       android:src="@drawable/lock_icon_3" />

                   <EditText
                       android:layout_toEndOf="@+id/imgconfLockPas"
                       android:id="@+id/confpassword_edt"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:background="@null"
                       android:paddingVertical="@dimen/fifteen"
                       android:hint="Confirm new password"
                       android:layout_marginHorizontal="@dimen/five"
                       android:inputType="textPassword"
                       android:paddingStart="12dp"
                       android:layout_toStartOf="@+id/img_confpasswordopen"
                       android:textColor="#0B1C30"
                       android:textColorHint="#717786"
                       android:textSize="15sp" />

                   <ImageView
                       android:layout_alignParentEnd="true"
                       android:id="@+id/img_confpasswordopen"
                       android:layout_width="24dp"
                       android:layout_height="24dp"
                       android:layout_centerVertical="true"
                       android:layout_marginEnd="14dp"
                       android:contentDescription="Show/hide password"
                       android:padding="2dp"
                       android:src="@drawable/ic_eye_off_2" />

               </RelativeLayout>



               <androidx.appcompat.widget.AppCompatButton
                   android:id="@+id/txt_next"
                   android:layout_width="match_parent"
                   android:layout_height="48dp"
                   android:layout_marginTop="28dp"
                   android:background="@drawable/bg_primary_button"
                   android:text="@string/txt_submit"
                   android:textAllCaps="false"
                   android:textColor="@color/white"
                   android:textSize="15sp"
                   android:textStyle="bold" />

           </LinearLayout>

       </androidx.core.widget.NestedScrollView>
   </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
