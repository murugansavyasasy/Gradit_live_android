<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    android:layout_marginHorizontal="@dimen/ten"
    android:layout_marginVertical="@dimen/five"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F3F4F6">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/eight">

        <!-- IMG Badge -->
        <TextView
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:id="@+id/txtFileType"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:background="@drawable/bg_file_type"
            android:gravity="center"
            android:text="IMG"
            android:textColor="#1E88E5"
            android:textStyle="bold"
            android:textSize="@dimen/ten_sp" />
        <RelativeLayout
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/txtFileType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/five"
                android:layout_alignParentStart="true"
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_toStartOf="@+id/imgDelete"
                android:id="@+id/lnrFileDetails"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/txtFileType"
                    android:layout_marginStart="12dp"
                    android:text="IMG000_1.png"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#000000"
                    android:textSize="@dimen/thirteen_sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFileInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/txtFileType"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgDelete"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/red_bin_delete_icon"
              />

        </RelativeLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
