<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/centerBlock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintBottom_toTopOf="@+id/viewDiv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:layout_width="match_parent"
            android:src="@drawable/curve_icon"
            android:tint="#fde7e5"
            android:layout_marginBottom="@dimen/thirty"
            android:layout_height="wrap_content">

        </ImageView>

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:contentDescription="GRADIT Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/gradit_splash_icon" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-smallcaps"
            android:gravity="center"
            android:textColor="@color/light_gray"
            android:text="ACE IT . GRAD IT ."
            android:textSize="20sp"
            />
        <ImageView
            android:tint="#fde7e5"
            android:layout_width="match_parent"
            android:src="@drawable/curve_icon"
            android:rotation="180"
            android:layout_marginTop="@dimen/thirty"
            android:layout_height="wrap_content">

        </ImageView>



    </LinearLayout>

    <View
        android:layout_marginBottom="@dimen/twenty"
        android:id="@+id/viewDiv"
        android:paddingTop="@dimen/twenty"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/clear_red"
        android:layout_width="@dimen/hundred"
        android:layout_height="4dp">

    </View>


</androidx.constraintlayout.widget.ConstraintLayout>
