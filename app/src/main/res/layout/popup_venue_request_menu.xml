<?xml version="1.0" encoding="utf-8"?>
<!-- Request List: "⋮" menu for waiting requests (Edit request / Cancel request) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_req_popup_menu"
    android:elevation="8dp"
    android:minWidth="180dp"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/menuEditRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_req_edit"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="20dp"
        android:paddingBottom="11dp"
        android:text="@string/txt_edit_request"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/menuCancelRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_req_cross"
        android:drawablePadding="12dp"
        android:drawableTint="#E11D48"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="20dp"
        android:paddingBottom="11dp"
        android:text="@string/txt_cancel_request"
        android:textColor="#E11D48"
        android:textSize="14sp" />
</LinearLayout>
