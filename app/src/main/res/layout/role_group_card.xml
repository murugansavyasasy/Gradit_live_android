<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ImgHeader"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:padding="@dimen/six"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_bg_green"

                />

            <TextView
                android:id="@+id/lblHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Principal"
                android:layout_marginStart="@dimen/five"
                android:textSize="16sp"
                android:layout_toEndOf="@+id/ImgHeader"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/lblHeaderCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/lblHeaderTitle"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"
                android:text="(1)"
                android:layout_toStartOf="@+id/imgArrow"
                android:textSize="14sp"
                android:textColor="#666666" />

            <ImageView
                android:id="@+id/imgArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="expand" />
        </RelativeLayout>

        <!-- Nested RecyclerView for profiles -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/innerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>