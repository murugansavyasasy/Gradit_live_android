<?xml version="1.0" encoding="utf-8"?>
<!-- Approve Venue: "Approve this request?" bottom sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_req_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_req_sheet_handle" />

    <FrameLayout
        android:id="@+id/layoutApproveIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp">

        <ImageView
            android:id="@+id/imgApproveIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_req_check" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/txt_approve_this_request"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/txt_approve_check_details"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Request summary -->
    <LinearLayout
        android:id="@+id/layoutApproveSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_venue_detail"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewApproveAccent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#2563EB" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/lblApproveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblApproveDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_req_calendar"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="#1E293B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lblApproveTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_req_clock"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="#1E293B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lblApproveVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_req_pin"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="#475569"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lblApproveRequester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_req_person"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="#475569"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Note -->
    <LinearLayout
        android:id="@+id/layoutApproveNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ic_req_info" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/txt_approve_note"
            android:textColor="#047857"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnApproveGoBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_event_btn_cancel"
            android:stateListAnimator="@null"
            android:text="@string/txt_go_back"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApproveConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_req_btn_approve"
            android:stateListAnimator="@null"
            android:text="@string/txt_yes_approve"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
