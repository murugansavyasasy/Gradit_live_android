<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ============ ATTENDANCE SUMMARY CARD ============ -->
    <soup.neumorphism.NeumorphCardView
        android:id="@+id/crd_attendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/crdattendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Subject name (heading) -->
                <TextView
                    android:id="@+id/txtnamesubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_subject_name"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtSubject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/clr_header_black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Staff name (subtitle) -->
                <TextView
                    android:id="@+id/txt_staffname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_staff_name"
                    android:textColor="@color/light_gray"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtSubject" />

                <TextView
                    android:id="@+id/lblstaffName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/clr_header_black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/txt_staffname"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/txt_staffname"
                    app:layout_constraintTop_toTopOf="@+id/txt_staffname" />

                <!-- Stat chips -->
                <LinearLayout
                    android:id="@+id/lne_attenpercentage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_staffname">

                    <LinearLayout
                        android:id="@+id/lbl24hours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_attend_green"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attended (hrs)"
                            android:textColor="@color/clr_green"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txt24hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/clr_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lbl12hours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_absent_red"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Absent (hrs)"
                            android:textColor="@color/clr_emergency_red"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txt12hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/clr_emergency_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Attendance percentage label -->
                <TextView
                    android:id="@+id/lblatten_presentage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text=""
                    android:textColor="@color/clr_header_black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lne_attenpercentage" />

                <!-- Progress bar -->
                <com.mackhartley.roundedprogressbar.RoundedProgressBar
                    android:id="@+id/customProgress"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lblatten_presentage"
                    app:rpbProgressColor="@color/clr_parent"
                    app:rpbShowProgressText="false"
                    app:rpbTextColor="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </soup.neumorphism.NeumorphCardView>

    <!-- ============ ATTENDANCE DETAIL TABLE ROW ============ -->
    <TableLayout
        android:id="@+id/tblattendance"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fourty_five"
        android:background="@drawable/bg_row_bottom_divider"
        android:stretchColumns="0,1,2,3"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="@dimen/fourty_five">

            <TextView
                android:id="@+id/lblsnumber"
                android:layout_width="0dp"
                android:layout_height="@dimen/fourty_five"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/light_gray"
                android:textSize="@dimen/fourteen" />

            <TextView
                android:id="@+id/lbldate"
                android:layout_width="0dp"
                android:layout_height="@dimen/fourty_five"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/clr_header_black"
                android:textSize="@dimen/fourteen" />

            <TextView
                android:id="@+id/lblattendhours"
                android:layout_width="0dp"
                android:layout_height="@dimen/fourty_five"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/clr_green"
                android:textSize="@dimen/fourteen"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblabsenthours"
                android:layout_width="0dp"
                android:layout_height="@dimen/fourty_five"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/clr_emergency_red"
                android:textSize="@dimen/fourteen"
                android:textStyle="bold" />
        </TableRow>
    </TableLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
