<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_shadow_white"
    android:fitsSystemWindows="true">

    <!-- ===== Card header + summary (click to expand) ===== -->
    <RelativeLayout
        android:id="@+id/examlist_constrine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Date / session group (top-right) -->
        <LinearLayout
            android:id="@+id/lnrExamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_calender"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar" />

            <TextView
                android:id="@+id/txt_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="08/05/3099"
                android:textColor="@color/clr_light_black"
                android:textSize="12sp" />

            <View
                android:id="@+id/view3"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/light_gray" />

            <TextView
                android:id="@+id/txt_fn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FN"
                android:textColor="@color/clr_light_black"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Exam name (top-left) -->
        <TextView
            android:id="@+id/txt_financeandaccounding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/lnrExamDate"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NameoftheExam"
            android:textColor="@color/light_gray"
            android:textSize="12sp" />

        <!-- Divider -->
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/txt_financeandaccounding"
            android:layout_marginTop="12dp"
            android:background="@color/whitegrey" />

        <!-- Blue accent bar -->
        <View
            android:id="@+id/blue_view"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_below="@+id/view"
            android:layout_alignTop="@+id/txt_testing_creating"
            android:layout_alignBottom="@+id/txt_bcom_Accounts"
            android:layout_alignParentStart="true"
            android:layout_marginTop="12dp"
            android:background="@color/btn_clr_blue" />

        <!-- Subject name -->
        <TextView
            android:id="@+id/txt_testing_creating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_toEndOf="@+id/blue_view"
            android:text="@string/txt_testing_exam_creating"
            android:textColor="@color/clr_header_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Venue chip -->
        <TextView
            android:id="@+id/txt_bcom_Accounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_testing_creating"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_toEndOf="@+id/blue_view"
            android:background="@drawable/sublistlist_lightblue_colour"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="Test sub"
            android:textColor="@color/clr_previous_submsion"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- ===== Expandable syllabus section ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/consrin2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/examlist_constrine">

        <View
            android:id="@+id/view4"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/whitegrey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_Syllabus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Syllabus Details:"
            android:textColor="@color/clr_header_black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view4" />

        <TextView
            android:id="@+id/txt_Syllabus1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Syllabus 1"
            android:textColor="@color/clr_light_black"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_Syllabus" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
